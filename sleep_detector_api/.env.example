# ===============================================================
# .env.example → 이 파일은 .env 내용의 공통 버전입니다. 여기는 항상 확인하고 변경된 값은 개인 .env에 바꾸어 주시면 됩니다.
# 🔴 .env 는 개인고유의 값으로,  GitHub 에 올리지 않습니다. 개인의 DB_PASSWORD= , SECRET_KEY= 값은 작성하여 넣지 마세요 !!!!!!!!!!!!!!!!!!!!!
# ===============================================================

# ── DB (각자 PC의 MySQL) ─────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sleep_detector

# ── JWT 서명 키 (각자 발급) ────────────
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   비어 있으면 로그인 때 "HMAC key must not be empty" 오류
SECRET_KEY=

# ── LLM · RAG · Agent (Gemini, 각자 발급) ─────────
GEMINI_API_KEY=
# OpenAI 호환 주소 (수업 코드의 OpenAI(...) 에 base_url 로 넣음)
GEMINI_BASE_URL=
# 모델 이름 — gemini-3.5-flash-lite 로 확정 (10/14)
GEMINI_MODEL=gemini-3.5-flash-lite
# 임베딩 — gemini-embedding-2 로 교체 (11/04, 001 과 벡터 호환 X → chroma_db 다시 만들어짐)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── 카카오 키 (관리자 웹 주소 변환) ──────────
#   KAKAO_API_KEY = 카카오 REST API 키. 졸음쉼터 도로 거리(/rest-areas/road-distance)에도 씀
#   → 카카오 개발자 콘솔에서 '카카오모빌리티 자동차 길찾기' 사용 권한이 있어야 함 (없으면 앱은 직선 거리)
KAKAO_API_KEY=
KAKAO_JS_KEY=
# 그림 그리는데 필요해서 추가함

# ── 구글 로그인 검증 ─────────────────────────────
#   FIREBASE_VERIFY=true 면 기사 앱의 구글 로그인도 id_token 을 검증 (앱이 id_token 을 보낼 때만 켜기). 관리자 계정은 이 값과 상관없이 항상 검증
FIREBASE_VERIFY=false
#   관리자 웹 구글 로그인 — Firebase 콘솔 → 프로젝트 설정. 앱의 google-services.json 의 project_id 와 같은 프로젝트
#   (콘솔 → Authentication → 설정 → 승인된 도메인에 관리자 웹 주소도 추가해야 구글 창이 열림)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# ── 메일 발송 (구글 SMTP) — 회원가입 이메일 인증번호 ──────────
#   구조: 앱 → 우리 서버 → 구글 SMTP. 아래 값은 서버 .env 에만 넣고, 앱 코드 · GitHub · 단톡에는 절대 올리지 않습니다.
#   SMTP_USER · SMTP_PASSWORD 가 둘 다 비어 있으면 메일을 보내지 않고 인증번호를 응답(demo_code)으로 주는 시연용으로 동작합니다.
#   준비: ① 메일 전용 구글 계정을 새로 만든다 (개인 드라이브 · 다른 서비스와 엮이지 않게)
#         ② 그 계정에 2단계 인증을 켠다  ③ 구글 계정 → 보안 → 2단계 인증 → '앱 비밀번호' 에서 16자리 발급
#         ④ 아래 SMTP_USER = 그 계정 주소, SMTP_PASSWORD = 앱 비밀번호 (계정의 진짜 비밀번호가 아님. 띄어쓰기째 붙여넣어도 됨)
#   확인: python tools/send_test_mail.py 받을이메일
SMTP_HOST=smtp.gmail.com
#   587 = STARTTLS (기본) · 465 = SSL
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=졸음 가드
#   서버 전체 하루 최대 발송 수 — 개인 구글 계정은 하루 500통을 넘으면 막히니 그 앞에서 멈춤 (기본 100)
MAIL_DAILY_LIMIT=100

# ── 관리자 가입 (관리자 웹 '사번으로 가입하기') ──────────────
#   이 목록의 사번만 관리자 계정을 만들 수 있어요 (쉼표로 구분, 숫자 4~12자리). 한 사번 = 한 계정. 기사 사번(employees 표)과는 별개
#   비워 두면 관리자 가입이 닫힘 → 관리자는 tools/make_admin.py 로만
#   🔴 이 번호가 곧 관리자 초대 코드 — 배포 서버(Railway Variables)는 알아맞히기 어려운 번호로. 아래 예시(모의 서버와 같은 번호)는 각자 PC 시험용
ADMIN_EMPLOYEE_NOS=20240001,20240002,20240003,20240004,20240005

# ── 시연 모드 (true 면 10분→1분, 15분→1분, 2시간→2분) ──
DEMO_MODE=false
