# ===============================================================
# .env.example → 복사해서 .env 로 만들고 본인 값을 넣으세요.
#   copy .env.example .env
# 🔴 .env 는 GitHub 에 올리지 않습니다. 비밀번호·키를 단톡에 붙여 넣지 마세요.
# ===============================================================

# ── DB (각자 PC의 MySQL) ─────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sleep_detector

# ── JWT 서명 키 (각자 아무 긴 문자열) ────────────
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   비어 있으면 로그인 때 "HMAC key must not be empty" 오류
SECRET_KEY=

# ── LLM · RAG · Agent (Gemini, 각자 발급) ─────────
GEMINI_API_KEY=
# OpenAI 호환 주소 (수업 코드의 OpenAI(...) 에 base_url 로 넣음)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 모델 이름 — B가 2주차에 최신 이름 확인 후 팀에 공지
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── 카카오 REST 키 (관리자 웹 주소 변환) ──────────
KAKAO_API_KEY=

# ── 구글 로그인 검증 ─────────────────────────────
FIREBASE_VERIFY=false
