# ===============================================================
# .env.example → 이 파일은 .env 내용의 공통 버전입니다. 여기는 항상 확인하고 변경된 값은 개인 .env에 바꾸어 주시면 됩니다.
# 🔴 .env 는 개인고유의 값으로,  GitHub 에 올리지 않습니다. 개인의 DB_PASSWORD= , SECRET_KEY= 값은 작성하여 넣지 마세요 !!!!!!!!!!!!!!!!!!!!!
# ===============================================================

# ── DB (각자 PC의 MySQL) ─────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sleep_detector

# ── JWT 서명 키 (각자 발급) ────────────
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   비어 있으면 로그인 때 "HMAC key must not be empty" 오류
SECRET_KEY=

# ── LLM · RAG · Agent (Gemini, 각자 발급) ─────────
GEMINI_API_KEY=
# OpenAI 호환 주소 (수업 코드의 OpenAI(...) 에 base_url 로 넣음)
GEMINI_BASE_URL=
# 모델 이름 — gemini-3.5-flash-lite 로 확정 (10/14)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── 카카오 REST 키 (관리자 웹 주소 변환) ──────────
KAKAO_API_KEY=

# ── 구글 로그인 검증 ─────────────────────────────
FIREBASE_VERIFY=false

# ── 시연 모드 (true 면 10분→1분, 15분→1분, 2시간→2분) ──
DEMO_MODE=false
